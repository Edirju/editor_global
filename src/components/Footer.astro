---

<footer
  class="h-8 border-t border-[rgb(var(--color),0.1)] bg-[rgb(var(--light),0.08)] text-[rgb(var(--color),0.85)] flex items-center justify-between px-4 text-[10px] font-inconsolata uppercase tracking-widest opacity-60"
>
  <div class="flex gap-4">
    <span id="word-count">0 Palabras</span>
    <span id="char-count">0 Caracteres</span>
    <span id="save-status" class="text-secondary-500 font-bold"
      >● Sincronizado</span
    >
  </div>
  <div>Markdown Editor v1.0 • Obsidian Clone</div>
</footer>

<script>
  import { useEditorStore } from "../store/useEditorStore";

  const saveStatus = document.getElementById("save-status");

  useEditorStore.subscribe((state, prevState) => {
    // Si el contenido cambió, mostramos "Guardando..." momentáneamente
    if (state.content !== prevState.content) {
      if (saveStatus) {
        saveStatus.innerText = "○ Guardando...";
        saveStatus.classList.replace("text-secondary-500", "text-orange-400");

        setTimeout(() => {
          saveStatus.innerText = "● Sincronizado";
          saveStatus.classList.replace("text-orange-400", "text-secondary-500");
        }, 1000);
      }
    }
  });
</script>
